# Copie este arquivo para ".env" e preencha com seus valores reais.
# Nunca suba o arquivo ".env" de verdade para o Git (ele já está no .gitignore).

# Chave da API da Anthropic. Crie a sua gratuitamente em https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-sua-chave-aqui

# Modelo usado nas respostas. claude-haiku-4-5-20251001 é mais barato para testar;
# troque para claude-sonnet-5 quando quiser respostas de qualidade maior.
CLAUDE_MODEL=claude-haiku-4-5-20251001

PORT=3001

# Chave que protege as rotas /api/documentos e /api/perguntas (header "x-api-key").
# Gere uma chave aleatória forte com o comando abaixo e cole o resultado aqui:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=troque-por-uma-chave-aleatoria-de-pelo-menos-32-caracteres

# Origem do front-end liberada no CORS. Em produção, use o domínio real do front-end.
FRONTEND_URL=http://localhost:5173

# Caminho do arquivo do banco SQLite (criado automaticamente na primeira execução).
DATABASE_PATH=./data/rag.db
